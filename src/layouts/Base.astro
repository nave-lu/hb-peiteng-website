---
import '../styles/global.css';
import site from '../data/site.json';
import { LANGS, LANG_NAME, HTML_LANG, t, href, type Lang } from '../i18n/ui';
import { NAV, sectionOf, menuLinks } from '../lib/content';

interface Props { lang: Lang; title: string; path: string; description?: string; editKey?: string }
const { lang, title, path, description } = Astro.props;
const current = sectionOf(path);
const fullTitle = path === '/' ? `${site.name} · ${site.fullName}` : `${title} · ${site.name}`;
const desc = description ?? t(lang, 'hero.title');
const joinPath = '/club/gëff-handballspiller-inn/';
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Wurzel der Seite (auf GitHub Pages wird das beim Hochladen zu /hb-peiteng-website/); der Admin braucht sie */}
    <meta name="site-base" content="/" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0e0e0c" />
    <link rel="icon" href="/brand/hbp-logo.svg" />
    <link rel="preload" href="/fonts/big-shoulders-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {LANGS.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={href(l, path)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="/fotos/i19c747d3d81ebcd6.jpg" />
  </head>
  <body data-lang={lang} data-path={path} class={path === '/' ? 'is-home' : undefined}>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="hbp-mesh" width="5" height="5" patternUnits="userSpaceOnUse"><circle cx="1.25" cy="1.25" r="0.85" fill="rgb(14 14 12 / 0.16)"/><circle cx="3.75" cy="3.75" r="0.85" fill="rgb(14 14 12 / 0.1)"/></pattern>
      </defs>
    </svg>
    <a class="skip" href="#inhalt">{t(lang, 'nav.skip')}</a>
    {/* Kopf ohne Leiste: Logo + Name links, rechts nur die drei Striche (bleiben beim Scrollen sichtbar) */}
    <header class="topbar">
      <div class="wrap topbar-in">
        <a class="brand" href={href(lang, '/')} aria-label={`${site.name} – Start`}>
          <img src="/brand/hbp-logo.svg" alt="" width="52" height="52" />
          <span>HB Péiteng</span>
        </a>
      </div>
    </header>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label={t(lang, 'nav.menu')} data-open-label={t(lang, 'nav.menu')} data-close-label={t(lang, 'nav.close')}>
      <span class="burger" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
    {/* Menü über die ganze Seite: links die Rubriken, rechts (Handy: darunter) ihre Seiten */}
    <div class="menu" id="menu">
      <a class="brand" href={href(lang, '/')} tabindex="-1">
        <img src="/brand/hbp-logo.svg" alt="" width="52" height="52" />
        <span>HB Péiteng</span>
      </a>
      <nav class="menu-main" aria-label="Haaptmenü">
        <ul>
          {NAV.map((n) => (
            <li class="menu-item" data-current={current?.key === n.key ? '' : undefined}>
              {/* große Schrift führt direkt zur Rubrik; „+“ (nur Handy) klappt ihre Seiten auf */}
              <div class="menu-row">
                <a class="menu-sec" href={href(lang, n.path)} aria-current={current?.key === n.key ? 'true' : undefined} data-edit={`ui:${n.key}`}>{t(lang, n.key)}</a>
                <button class="menu-toggle" type="button" aria-expanded="false" aria-label={t(lang, n.key)}><span aria-hidden="true"></span></button>
              </div>
              <ul class="menu-sub">
                {menuLinks(n, lang).map((p) => <li class={p.depth ? 'is-sub' : undefined}><a href={href(lang, p.path)} aria-current={p.path === path ? 'page' : undefined}>{p.title}</a></li>)}
              </ul>
            </li>
          ))}
          {/* Kontakt wie die anderen Rubriken: rechts (Handy: aufklappen) Kontaktseite, E-Mails, Hallen, Partner werden */}
          <li class="menu-item" data-current={path === '/kontakt/' ? '' : undefined}>
            <div class="menu-row">
              <a class="menu-sec" href={href(lang, '/kontakt/')} aria-current={path === '/kontakt/' ? 'page' : undefined} data-edit="ui:nav.contact">{t(lang, 'nav.contact')}</a>
              <button class="menu-toggle" type="button" aria-expanded="false" aria-label={t(lang, 'nav.contact')}><span aria-hidden="true"></span></button>
            </div>
            <ul class="menu-sub">
              <li><a href={href(lang, '/kontakt/')}>{t(lang, 'contact.title')}</a></li>
              <li><a href={`mailto:${site.emails.club}`}>{site.emails.club}</a></li>
              <li><a href={`mailto:${site.emails.president}`}>{site.emails.president}</a></li>
              <li><a href={href(lang, '/club/sportshalen/')}>{t(lang, 'footer.halls')}</a></li>
              <li><a href={href(lang, '/kontakt/') + '#partner'}>{t(lang, 'partner.become')}</a></li>
            </ul>
          </li>
        </ul>
      </nav>
      <div class="menu-foot">
        <a class="tag-btn" href={href(lang, joinPath)} data-edit="ui:cta.training">{t(lang, 'cta.training')}</a>
        <div class="lang" aria-label="Sprooch">
          {LANGS.map((l) => <a href={href(l, path)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === lang ? 'true' : undefined} data-keep-menu>{LANG_NAME[l]}</a>)}
        </div>
      </div>
    </div>

    {/* Sprachwechsel aus dem offenen Menü: Menü schon beim Laden offen zeigen (vor dem ersten Bild, keine Animation) */}
    <script is:inline>
      try {
        if (sessionStorage.getItem('menu-open')) {
          document.documentElement.classList.add('menu-restored');
          document.documentElement.style.overflow = 'hidden';
          document.getElementById('menu').setAttribute('data-open', '');
          document.querySelector('.menu-btn').setAttribute('aria-expanded', 'true');
        }
      } catch (e) {}
    </script>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="shorts">
      <div class="wrap">
        <div class="shorts-grid">
          <div>
            <div class="shorts-brand">
              <img src="/brand/hbp-logo.svg" alt="" width="64" height="64" loading="lazy" />
              <strong>{site.fullName.replace(' a.s.b.l.', '')}</strong>
            </div>
            <h2 data-edit="ui:footer.address">{t(lang, 'footer.address')}</h2>
            <p>{site.fullName}<br />{site.address.map((l) => <>{l}<br /></>)}</p>
          </div>
          <div>
            <h2 data-edit="ui:nav.contact">{t(lang, 'nav.contact')}</h2>
            <ul>
              <li><a href={`mailto:${site.emails.club}`}>{site.emails.club}</a></li>
              <li><a href={`mailto:${site.emails.president}`}>{site.emails.president}</a></li>
              <li><a href={`mailto:${site.emails.wisiCup}`}>{site.emails.wisiCup}</a></li>
            </ul>
          </div>
          <div>
            <h2 data-edit="ui:footer.halls">{t(lang, 'footer.halls')}</h2>
            <ul>
              {site.halls.map((h) => <li>{h.page ? <a href={href(lang, h.page)}>{h.name}</a> : h.name}<br /><span>{[h.street, h.city].filter(Boolean).join(', ')}</span></li>)}
            </ul>
          </div>
          <div>
            <h2 data-edit="ui:footer.follow">{t(lang, 'footer.follow')}</h2>
            <ul>
              <li><a href={site.links.flhKlassement} target="_blank" rel="noopener" data-edit="ui:weekend.table">{t(lang, 'weekend.table')}</a></li>
              <li><a href={site.links.livestream} target="_blank" rel="noopener" data-edit="ui:weekend.live">{t(lang, 'weekend.live')}</a></li>
              <li><a href={href(lang, '/partner/')} data-edit="ui:partner.all">{t(lang, 'partner.all')}</a></li>
              <li><a href={href(lang, '/shop/')}>Shop</a></li>
            </ul>
          </div>
        </div>
      </div>
      {/* letzte Zeile genau in der Seitenmitte (die Spalten darüber sind wegen der Streifen links versetzt) */}
      <div class="shorts-bottom">
          <div class="shorts-base">
            <span>© {new Date().getFullYear()} {site.fullName}</span>
            <nav aria-label="Rechtliches">
              <a href={href(lang, '/impressum/')} data-edit="ui:footer.legal">{t(lang, 'footer.legal')}</a>
              <a href={href(lang, '/dateschutz/')} data-edit="ui:footer.privacy">{t(lang, 'footer.privacy')}</a>
              <a href="#login" data-login>{t(lang, 'footer.login')}</a>
            </nav>
            <a class="made-by" href="https://nave.lu" target="_blank" rel="noopener">Created by <img src="/brand/nave-n.png" alt="" width="15" height="18" loading="lazy" /><img class="made-by-word" src="/brand/nave-wordmark.png" alt="Nave" width="43" height="14" loading="lazy" /></a>
          </div>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="Foto">
      <button class="lb-close" type="button" aria-label={t(lang, 'gallery.close')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></button>
      <button class="lb-prev" type="button" aria-label={t(lang, 'gallery.prev')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4L6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button class="lb-next" type="button" aria-label={t(lang, 'gallery.next')}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </dialog>

    <script>
      import '../scripts/site';
    </script>
    <script>
      import '../edit/boot';
    </script>
  </body>
</html>
